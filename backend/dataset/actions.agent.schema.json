{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hasaneyldrm/exercises-dataset/blob/main/data/actions.agent.schema.json",
  "title": "Actions Agent Dataset",
  "description": "Schema for data/actions.agent.json — a trimmed array of fitness exercise records with Chinese and English step-by-step instructions only.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/action"
  },
  "$defs": {
    "steps": {
      "type": "object",
      "description": "Ordered step-by-step instructions keyed by ISO 639-1 language code.",
      "properties": {
        "zh": {
          "type": "array",
          "description": "Instruction steps in Chinese.",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "en": {
          "type": "array",
          "description": "Instruction steps in English.",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "required": ["zh", "en"],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique numeric identifier, zero-padded to 4 digits (e.g. \"0001\").",
          "pattern": "^[0-9]{4}$"
        },
        "name": {
          "type": "string",
          "description": "Full exercise name in Simplified Chinese (e.g. \"3/4仰卧起坐\", \"杠铃卧推\").",
          "minLength": 1
        },
        "load_convention": {
          "type": ["string", "null"],
          "description": "Weight-recording convention for this exercise. per_implement = weight of a single dumbbell/kettlebell (or one implement held with both hands); barbell_total = barbell weight including the bar; machine_display = training weight shown on the machine display, in kilograms; plates_total = total weight of loaded plates, excluding the machine's own weight; per_side = weight loaded on one side; added_weight = extra load beyond body weight; assistance_weight = assist weight provided by an assisted machine, where a larger value means more assistance; null = no weight to record, or the convention cannot be determined from the available data.",
          "enum": [
            "per_implement",
            "barbell_total",
            "machine_display",
            "plates_total",
            "per_side",
            "added_weight",
            "assistance_weight",
            null
          ]
        },
        "body_part": {
          "type": "string",
          "description": "Body part targeted.",
          "enum": [
            "back",
            "cardio",
            "chest",
            "lower arms",
            "lower legs",
            "neck",
            "shoulders",
            "upper arms",
            "upper legs",
            "waist"
          ]
        },
        "equipment": {
          "type": "string",
          "description": "Required equipment (e.g. \"dumbbell\", \"body weight\").",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "description": "Primary target muscle (e.g. \"biceps\", \"pectorals\").",
          "minLength": 1
        },
        "muscle_group": {
          "type": "string",
          "description": "Primary synergist muscle group.",
          "minLength": 1
        },
        "secondary_muscles": {
          "type": "array",
          "description": "Additional muscles involved.",
          "items": { "type": "string", "minLength": 1 }
        },
        "steps": { "$ref": "#/$defs/steps" }
      },
      "required": [
        "id",
        "name",
        "load_convention",
        "body_part",
        "equipment",
        "target",
        "muscle_group",
        "secondary_muscles",
        "steps"
      ],
      "additionalProperties": false
    }
  }
}
