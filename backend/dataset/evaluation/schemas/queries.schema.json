{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fit-agent.local/evaluation/queries.schema.json",
  "title": "Evaluation Retrieval Query Row",
  "description": "queries.jsonl 单行结构。每条请求保存真实检索文本、线上用途、完整条件、交叉标签、判断范围与用户审阅记录。",
  "type": "object",
  "required": [
    "query_id",
    "scenario_id",
    "query",
    "purpose",
    "conditions",
    "tags",
    "family",
    "expect_empty",
    "judgement_scope",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "query_id": {"type": "string", "pattern": "^q-[a-z0-9][a-z0-9_-]*-[0-9]{3}$"},
    "scenario_id": {"type": ["string", "null"], "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["lookup", "generation", "replacement"]},
    "conditions": {"$ref": "https://fit-agent.local/evaluation/defs.schema.json#/$defs/conditions"},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
    },
    "family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "expect_empty": {"type": "boolean"},
    "judgement_scope": {"$ref": "https://fit-agent.local/evaluation/defs.schema.json#/$defs/judgement_scope"},
    "review": {"$ref": "https://fit-agent.local/evaluation/defs.schema.json#/$defs/review"}
  }
}
