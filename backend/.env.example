# 检索配置：在 backend/.env 中填写，修改后重启后端。
# 以下 API Key 与业务空间 ID 均为示例，使用前替换为自己的真实配置。
# 密钥仅保存在本地 .env 中；对话模型服务通过应用侧栏设置。
# 推荐使用阿里云百炼北京地域；API Key、业务空间和请求地址须属于同一地域。

# Milvus：本机 Compose 部署的向量数据库地址。
FIT_AGENT_MILVUS_URI=http://127.0.0.1:19530
# 连接超时秒数，必须为有限正数；示例为 10 秒。
FIT_AGENT_MILVUS_TIMEOUT=10

# DashScope 是阿里云百炼提供的模型 API 服务，下面配置其调用密钥和业务空间。
# API Key：在百炼北京地域的 API Key 页面创建并复制完整密钥。
# https://bailian.console.aliyun.com/cn-beijing/model/settings/api-key
# 获取说明：https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-example0123456789abcdef0123456789abcdef
# 业务空间：在下列页面查看 API Host，取域名第一个点之前的部分作为 ID。
# https://bailian.console.aliyun.com/cn-beijing/settings/workspace
# 例如 API Host 为 llm-example123456.cn-beijing.maas.aliyuncs.com，对应 ID 如下。
DASHSCOPE_WORKSPACE_ID=llm-example123456

# Embedding（文本向量化）：将动作描述转换为数值向量，用于语义检索。
# 程序根据业务空间 ID 自动生成 Base URL，示例：
# https://llm-example123456.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 完整 Embedding API 示例（POST）：
# https://llm-example123456.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/embeddings
# 模型及 API 说明：https://help.aliyun.com/zh/model-studio/text-embedding-synchronous-api
FIT_AGENT_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 当前索引仅支持 1024 维；模型须与已构建的动作索引一致。
FIT_AGENT_EMBEDDING_DIMENSIONS=1024

# Rerank（重排）：根据查询与候选动作的相关性重新排序检索结果。
# 使用百炼的 DashScope HTTP 接口，BASE_URL 填写包含接口路径的完整地址。
# 将下面域名中的 llm-example123456 替换为自己的北京地域业务空间 ID。
# 模型及 API 说明：https://help.aliyun.com/zh/model-studio/text-rerank-api
RERANKER_MODEL=qwen3.7-text-rerank
RERANKER_BASE_URL=https://llm-example123456.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 同一业务空间下，可填写与 DASHSCOPE_API_KEY 相同的百炼 API Key。
RERANKER_API_KEY=sk-example0123456789abcdef0123456789abcdef
# 重排超时秒数，必须为有限正数，默认 10。
RERANKER_TIMEOUT=10
